  m_Script: {fileID: 11500000, guid: b6557b1e53a44f84b969bfbed5b80472, type: 3}
  m_Name: dlg_level05_intro
  m_EditorClassIdentifier: RootAccess.Systems::RootAccess.Systems.DialogueDefinition
  dialogueId: dlg_level05_intro
  lines:
  - speaker: OPERATOR
    text: "Sediul. Gardieni grei, luneti\u0219ti, turele \u0219i lasere peste tot."
  - speaker: OPERATOR
    text: "Liftul executiv duce la mainframe. Dup\u0103 asta, fugi pe acoperi\u0219."
  - speaker: TU
    text: "Hai s\u0103 termin\u0103m ce am \xEEnceput."
