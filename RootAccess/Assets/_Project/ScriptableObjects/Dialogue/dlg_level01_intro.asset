  m_Script: {fileID: 11500000, guid: b6557b1e53a44f84b969bfbed5b80472, type: 3}
  m_Name: dlg_level01_intro
  m_EditorClassIdentifier: RootAccess.Systems::RootAccess.Systems.DialogueDefinition
  dialogueId: dlg_level01_intro
  lines:
  - speaker: OPERATOR
    text: "Te v\u0103d pe camer\u0103. Mi\u0219c\u0103-te cu A/D, sari cu Space,
      dash cu Shift."
  - speaker: OPERATOR
    text: "Gardienii v\u0103d doar ce e \xEEn conul lor de lumin\u0103. Stai ghemuit
      \xEEn umbr\u0103."
  - speaker: OPERATOR
    text: "\u0218i ai grij\u0103 la zgomot: pa\u0219ii pe metal se aud. Ghemuit nu
      faci niciun zgomot."
