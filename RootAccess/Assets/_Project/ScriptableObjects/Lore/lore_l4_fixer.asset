  m_Script: {fileID: 11500000, guid: 245063d0074fa454484ef1dca8c13a2d, type: 3}
  m_Name: lore_l4_fixer
  m_EditorClassIdentifier: RootAccess.Systems::RootAccess.Systems.LoreDefinition
  loreId: lore_l4_fixer
  title: Mesaj de la fixer
  body: "Dac\u0103 ai ajuns \xEEn canale, ferma a picat \u0219i ei \u0219tiu. Te
    urm\u0103resc acum pe trei re\u021Bele diferite. Nu te opri, nu r\u0103spunde
    la apeluri \u0219i nu bea apa, oric\xE2t de cald\u0103 ar fi."
  titleEn: Message from the fixer
  bodyEn: If you made it to the sewers, the farm went down and they know it. They
    are tracking you on three different networks now. Don't stop, don't answer calls
    and don't drink the water, however warm it is.
  levelId: level04
  order: 10
